{
  "name": "harni",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Author site and bookstore for harni.uk",
  "scripts": {
    "pages": "node scripts/build-pages.ts",
    "predev": "npm run pages",
    "dev": "vite",
    "prebuild": "npm run pages",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:mail": "php -S 127.0.0.1:5153 -t public",
    "test:mail": "php tests/unit/mail.test.php",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts",
    "media": "./scripts/build-media.sh"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
