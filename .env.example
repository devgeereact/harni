# Names only. Never place real credentials in this file.
# The real values are set in the host's private configuration, outside every web root, and never in git.

# Mail switch for the contact and mailing-list endpoint. Sending happens only when this is set to 1.
HARNI_MAIL_ENABLED=

# Private directory (outside the web root) where the endpoint keeps its rate-limit state.
HARNI_MAIL_STATE_DIR=

# Secret key for the rate limiter: 32 or more random characters generated by the operator.
HARNI_MAIL_RATE_KEY=
